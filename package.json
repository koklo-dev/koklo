{
  "name": "koklo",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "lint": "turbo run lint && turbo boundaries && node packages/config/src/check-deep-imports.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "node e2e/scripts/dev.ts",
    "e2e": "node e2e/scripts/run.ts",
    "deploy:check": "bash scripts/deploy-check.sh",
    "db:migrate": "pnpm --filter @koklo/db migrate",
    "db:rollback": "pnpm --filter @koklo/db rollback",
    "db:seed": "pnpm --filter @koklo/db seed"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
