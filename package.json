{
  "name": "koklo",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "lint": "turbo run lint && turbo boundaries && node packages/config/src/check-deep-imports.ts && pnpm check:size",
    "check:size": "pnpm --filter @koklo/config check:size",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "e2e": "turbo run e2e",
    "db:migrate": "pnpm --filter @koklo/db migrate",
    "db:rollback": "pnpm --filter @koklo/db rollback"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
