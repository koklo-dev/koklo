          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Internal"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            },
            "description": "Erreur interne"
          }
        }
      }
