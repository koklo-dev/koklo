{
  "components": {
    "schemas": {
      "Forbidden": {
        "properties": {
          "code": {
            "const": "FORBIDDEN"
          },
          "data": {},
          "defined": {
            "const": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message"],
        "title": "FORBIDDEN",
        "type": "object"
      },
      "Internal": {
        "properties": {
          "code": {
            "const": "INTERNAL"
          },
          "data": {
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string"
              }
            },
            "required": ["requestId"],
            "type": "object"
          },
          "defined": {
            "const": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message", "data"],
        "title": "INTERNAL",
        "type": "object"
      },
      "Unauthorized": {
        "properties": {
          "code": {
            "const": "UNAUTHORIZED"
          },
          "data": {},
          "defined": {
            "const": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message"],
        "title": "UNAUTHORIZED",
        "type": "object"
      },
      "UndefinedError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "data": {},
          "defined": {
            "const": false
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message"],
        "title": "UndefinedError",
        "type": "object"
