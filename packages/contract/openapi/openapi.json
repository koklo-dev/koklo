{
  "components": {
    "schemas": {
      "Conflict": {
        "properties": {
          "code": {
            "const": "CONFLICT"
          },
          "data": {
            "additionalProperties": false,
            "properties": {
              "reason": {
                "enum": ["slug_taken", "already_member", "already_invited", "last_owner"],
                "type": "string"
              }
            },
            "required": ["reason"],
            "type": "object"
          },
          "defined": {
            "const": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message", "data"],
        "title": "CONFLICT",
        "type": "object"
      },
      "Forbidden": {
        "properties": {
          "code": {
            "const": "FORBIDDEN"
          },
          "data": {},
          "defined": {
            "const": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message"],
        "title": "FORBIDDEN",
        "type": "object"
      },
      "Internal": {
        "properties": {
          "code": {
            "const": "INTERNAL"
          },
          "data": {
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string"
              }
            },
            "required": ["requestId"],
            "type": "object"
          },
          "defined": {
            "const": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message", "data"],
        "title": "INTERNAL",
        "type": "object"
      },
      "NotFound": {
        "properties": {
          "code": {
            "const": "NOT_FOUND"
          },
          "data": {},
          "defined": {
            "const": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message"],
        "title": "NOT_FOUND",
        "type": "object"
      },
      "Unauthorized": {
        "properties": {
          "code": {
            "const": "UNAUTHORIZED"
          },
          "data": {},
          "defined": {
            "const": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message"],
        "title": "UNAUTHORIZED",
        "type": "object"
      },
      "UndefinedError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "data": {},
          "defined": {
            "const": false
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["defined", "code", "message"],
        "title": "UndefinedError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Koklo API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "const": "ok",
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "version"],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Internal"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            },
            "description": "Erreur interne"
          }
        }
      }
    },
    "/members": {
      "get": {
        "operationId": "member.list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "email": {
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                        "type": "string"
                      },
                      "id": {
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "role": {
                        "enum": ["owner", "admin", "dev", "designer", "client", "business"],
                        "type": "string"
                      },
                      "userId": {
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                        "type": "string"
                      }
                    },
                    "required": ["id", "userId", "name", "email", "role"],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Unauthorized"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            },
            "description": "Session absente ou expirée"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Internal"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            },
            "description": "Erreur interne"
          }
        }
      }
    },
    "/members/invitations": {
      "post": {
        "operationId": "member.invite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "type": "string"
                  },
                  "role": {
                    "enum": ["admin", "dev", "designer", "client", "business"],
                    "type": "string"
                  }
                },
                "required": ["email", "role"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "email": {
                      "format": "email",
                      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                      "type": "string"
                    },
                    "expiresAt": {
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                      "type": "string"
                    },
                    "id": {
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string"
                    },
                    "role": {
                      "enum": ["admin", "dev", "designer", "client", "business"],
                      "type": "string"
                    },
                    "status": {
                      "const": "pending",
                      "type": "string"
                    }
                  },
                  "required": ["id", "email", "role", "status", "expiresAt"],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Unauthorized"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            },
            "description": "Session absente ou expirée"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Forbidden"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            },
            "description": "Accès refusé"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Conflict"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            },
            "description": "Conflit avec l'état actuel"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Internal"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            },
            "description": "Erreur interne"
          }
        }
      }
    },
