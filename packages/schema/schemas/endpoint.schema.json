{
  "$id": "https://koklo.dev/schemas/spec/v1/endpoint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chemin": {
      "format": "starts_with",
      "pattern": "^\\/.*",
      "type": "string"
    },
    "entree": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "erreurs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "statut": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "statut",
          "code"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^E-[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "methode": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "type": "string"
    },
    "sortie": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "tables": {
      "items": {
        "pattern": "^T-[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "methode",
    "chemin"
  ],
  "type": "object"
}
