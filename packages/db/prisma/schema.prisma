generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// Tables Better Auth (+ plugin organization). Champs alignés sur la doc Better Auth.
model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions                Session[]
  accounts                Account[]
  members                 Member[]
  invitations             Invitation[]
  providerAuthStates      ProviderAuthState[]
  providerUserCredentials ProviderUserCredential[]

  @@map("users")
}

model Session {
  id                   String   @id @default(uuid(7)) @db.Uuid
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id") @db.Uuid
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members     Member[]
  invitations Invitation[]
  projects    Project[]

  tickets            Ticket[]
  ticketLabels       TicketLabel[]
  ticketFeatures     TicketFeature[]
  acceptanceCriteria AcceptanceCriterion[]
  ticketDependencies TicketDependency[]
  sprints            Sprint[]
  projectStates      ProjectState[]
  leases             Lease[]
  ticketComments     TicketComment[]
  auditLog           AuditLog[]
  projectCounters    ProjectCounter[]

  providerInstallations   ProviderInstallation[]
  projectRepos            ProjectRepo[]
  specSnapshots           SpecSnapshot[]
  specHeads               SpecHead[]
  specFeatures            SpecFeature[]
  specCriteria            SpecCriterion[]
  specTables              SpecTable[]
  specEndpoints           SpecEndpoint[]
  specFeatureTables       SpecFeatureTable[]
  specFeatureEndpoints    SpecFeatureEndpoint[]
  specWriteBatches        SpecWriteBatch[]
  specWriteOperations     SpecWriteOperation[]
  providerAuthStates      ProviderAuthState[]
  providerUserCredentials ProviderUserCredential[]

  @@map("organizations")
}

model Member {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at")
  inviterId      String   @map("inviter_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([inviterId])
  @@map("invitations")
}

// Table métier : toute table métier porte organization_id indexé (CDC §18.4).
model Project {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  sprints      Sprint[]
  state        ProjectState?
  counters     ProjectCounter[]
  repos        ProjectRepo[]
  writeBatches SpecWriteBatch[]

  // Cible des clés étrangères composites (organization_id, project_id) des tables de TK-41 (H2).
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("projects")
}

// ---------------------------------------------------------------------------------------------
// Tickets, sprints, baux (CDC §4.2, §7). Listes fermées = enums natifs, alignés sur @koklo/domain
// (test de parité). Aucune colonne tableau (incident 6) : les listes sont des tables de liaison.
// Objets SQL non exprimables ici (index uniques partiels, CHECK, triggers) : voir la migration
// `*_tickets_sprints_leases/migration.sql`.
// ---------------------------------------------------------------------------------------------

enum TicketStatus {
  backlog
  todo
  in_progress
  in_review
  blocked
  done
  cancelled

  @@map("ticket_status")
}

enum TicketType {
  feature
  bug
  task
  chore

  @@map("ticket_type")
}

enum TicketPriority {
  low
  medium
  high
  critical

  @@map("ticket_priority")
}

enum TicketPackage {
  web
  api
  worker
  contract
  db
  domain
  schema
  github
  rules
  delivery
  cli
  ui
  config
  e2e
  infra

  @@map("ticket_package")
}

enum Sensitivity {
  safe
  sensitive

  @@map("sensitivity")
}

/// Titulaire d'un bail ou assigné d'un ticket (member ou runner).
enum HolderKind {
  member
  runner

  @@map("holder_kind")
}

enum DependencyType {
  blocks
  related

  @@map("dependency_type")
}

enum SprintStatus {
  planned
  active
  closed

  @@map("sprint_status")
}

enum ProofStatus {
  pending
  proven
  failed

  @@map("proof_status")
}

enum CommentTargetKind {
  ticket
  feature
  screen
  change_request

  @@map("comment_target_kind")
}

enum CommentAuthorKind {
  human
  agent
  client
  system

  @@map("comment_author_kind")
}

enum AuditActorKind {
  human
  agent
  runner
  system

  @@map("audit_actor_kind")
}

enum CounterName {
  ticket
  sprint
  feature

  @@map("counter_name")
}

model Ticket {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  key            String
  title          String
  description    String
  type           TicketType
  status         TicketStatus
  priority       TicketPriority
  sprintId       String?        @map("sprint_id") @db.Uuid
  assigneeKind   HolderKind?    @map("assignee_kind")
  assigneeId     String?        @map("assignee_id")
  pkg            TicketPackage
  sensitivity    Sensitivity
  estimateHours  Decimal?       @map("estimate_hours") @db.Decimal(6, 2)
  branch         String?
  pullRequest    String?        @map("pull_request")
  attempts       Int            @default(0)
  reviewRounds   Int            @default(0) @map("review_rounds")
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?               @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  labels       TicketLabel[]
  features     TicketFeature[]
  criteria     AcceptanceCriterion[]
  dependencies TicketDependency[]    @relation("TicketDependsOn")
  dependents   TicketDependency[]    @relation("TicketDependedOnBy")
  leases       Lease[]

  @@unique([projectId, key])
  @@index([organizationId])
  @@index([projectId, status])
  @@index([sprintId])
  @@map("tickets")
}

model TicketLabel {
  organizationId String @map("organization_id") @db.Uuid
  ticketId       String @map("ticket_id") @db.Uuid
  label          String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([ticketId, label])
  @@index([organizationId])
  @@map("ticket_labels")
}

model TicketFeature {
  organizationId String @map("organization_id") @db.Uuid
  ticketId       String @map("ticket_id") @db.Uuid
  featureRef     String @map("feature_ref")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([ticketId, featureRef])
  @@index([organizationId])
  @@map("ticket_features")
}

model AcceptanceCriterion {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  ticketId       String      @map("ticket_id") @db.Uuid
  position       Int
  statement      String
  specRef        String?     @map("spec_ref")
  proofStatus    ProofStatus @default(pending) @map("proof_status")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, position])
  @@index([organizationId])
  @@map("acceptance_criteria")
}

/// `ticketId` dépend de `dependsOnId`. Pas de cycle ni d'auto-dépendance (CHECK) : le domaine refuse les cycles.
model TicketDependency {
  organizationId String         @map("organization_id") @db.Uuid
  ticketId       String         @map("ticket_id") @db.Uuid
  dependsOnId    String         @map("depends_on_id") @db.Uuid
  type           DependencyType

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation("TicketDependsOn", fields: [ticketId], references: [id], onDelete: Cascade)
  dependsOn    Ticket       @relation("TicketDependedOnBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([ticketId, dependsOnId, type])
  @@index([organizationId])
  @@index([dependsOnId])
  @@map("ticket_dependencies")
}

model Sprint {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  projectId        String       @map("project_id") @db.Uuid
  number           Int
  key              String
  goal             String
  startsOn         DateTime     @map("starts_on") @db.Date
  endsOn           DateTime     @map("ends_on") @db.Date
  status           SprintStatus
  definitionOfDone String       @map("definition_of_done")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@unique([projectId, number])
  @@index([organizationId])
  @@map("sprints")
}

/// Écriture optimiste : `UPDATE … WHERE project_id = $1 AND version = $attendue SET version = version + 1`.
model ProjectState {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @unique @map("project_id") @db.Uuid
  version        Int      @default(1)
  content        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("project_states")
}

/// Un seul bail non libéré par ticket (index unique partiel `WHERE released_at IS NULL`, migration).
model Lease {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  ticketId       String     @map("ticket_id") @db.Uuid
  holderKind     HolderKind @map("holder_kind")
  holderId       String     @map("holder_id")
  branch         String
  worktree       String
  acquiredAt     DateTime   @map("acquired_at") @db.Timestamptz(3)
  heartbeatAt    DateTime   @map("heartbeat_at") @db.Timestamptz(3)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  ttlMs          Int        @map("ttl_ms")
  releasedAt     DateTime?  @map("released_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ticketId])
  @@map("leases")
}

model TicketComment {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  targetKind     CommentTargetKind @map("target_kind")
  targetId       String            @map("target_id") @db.Uuid
  authorKind     CommentAuthorKind @map("author_kind")
  authorId       String?           @map("author_id")
  body           String
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([targetKind, targetId])
  @@map("ticket_comments")
}

/// Journal immuable (triggers UPDATE/DELETE/TRUNCATE, migration). Pas de `updated_at` : une ligne
/// n'est jamais modifiée (exception §18.1). Suppression permise uniquement avec l'organisation.
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  actorKind      AuditActorKind @map("actor_kind")
  actorId        String?        @map("actor_id")
  tokenId        String?        @map("token_id")
  action         String
  targetKind     String         @map("target_kind")
  targetId       String         @map("target_id") @db.Uuid
  ticketId       String?        @map("ticket_id") @db.Uuid
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ticketId])
  @@map("audit_log")
}

/// Compteur transactionnel des clés lisibles (`TK-n`, `SP-n`) : ne recule jamais.
model ProjectCounter {
  organizationId String      @map("organization_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  name           CounterName
  lastValue      Int         @default(0) @map("last_value")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, name])
  @@index([organizationId])
  @@map("project_counters")
}

// ---------------------------------------------------------------------------------------------
// Fournisseur git, repos du projet, index de la spec, lots d'écriture du bot, webhooks (TK-41,
// CDC §4, §5, §8). Aucun secret en base : ni jeton d'installation, ni clé privée, ni user token.
// Les enfants référencent leur parent par une clé étrangère COMPOSITE (organization_id, parent_id)
// vers `UNIQUE(organization_id, id)` : une ligne ne peut pas pointer un parent d'une autre
// organisation, même en contournant l'extension tenant (H2). Objets SQL non exprimables ici (index
// partiels, CHECK) : voir la migration `*_provider_spec_index/migration.sql`.
// ---------------------------------------------------------------------------------------------

enum Provider {
  github

  @@map("provider")
}

enum InstallationStatus {
  active
  suspended
  deleted

  @@map("installation_status")
}

enum OwnerKind {
  organization
  user

  @@map("owner_kind")
}

enum RepoRole {
  spec
  front
  back
  monorepo
  mobile

  @@map("repo_role")
}

enum RepoMode {
  new
  adopted

  @@map("repo_mode")
}

enum WebhookEvent {
  installation
  push
  pull_request
  pull_request_review
  check_suite
  check_run
  workflow_run
  deployment_status

  @@map("webhook_event")
}

enum WebhookDeliveryStatus {
  received
  processing
  processed
  ignored
  failed

  @@map("webhook_delivery_status")
}

enum SpecIndexStatus {
  building
  ready
  failed

  @@map("spec_index_status")
}

enum FeatureStatus {
  brouillon
  specifiee
  implementee
  adoptee

  @@map("feature_status")
}

enum FeaturePriority {
  must
  should
  could
  wont

  @@map("feature_priority")
}

enum EndpointMethod {
  GET
  POST
  PUT
  PATCH
  DELETE

  @@map("endpoint_method")
}

enum WriteBatchStatus {
  queued
  committing
  committed
  failed
  conflict

  @@map("write_batch_status")
}

/// Identifiants publics côté fournisseur uniquement (CDC §20.3 : aucun jeton ni clé en base).
model ProviderInstallation {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  provider       Provider
  externalId     String             @map("external_id")
  ownerKind      OwnerKind          @map("owner_kind")
  ownerLogin     String             @map("owner_login")
  status         InstallationStatus
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repos           ProjectRepo[]
  authStates      ProviderAuthState[]
  userCredentials ProviderUserCredential[]

  @@unique([provider, externalId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("provider_installations")
}

/// Au plus un repo porteur de la spec par projet (index unique partiel, migration).
model ProjectRepo {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  installationId   String    @map("installation_id") @db.Uuid
  role             RepoRole
  mode             RepoMode
  externalId       String    @map("external_id")
  ownerLogin       String    @map("owner_login")
  name             String
  defaultBranch    String    @map("default_branch")
  specPath         String?   @map("spec_path")
  lastReconciledAt DateTime? @map("last_reconciled_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  installation ProviderInstallation @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Cascade)
  snapshots    SpecSnapshot[]
  heads        SpecHead[]
  writeBatches SpecWriteBatch[]

  @@unique([installationId, externalId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([projectId])
  @@map("project_repos")
}

/// Projection d'un commit de la spec (snapshot complet, reconstruction idempotente par commit).
model SpecSnapshot {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  repoId         String          @map("repo_id") @db.Uuid
  commitSha      String          @map("commit_sha")
  status         SpecIndexStatus
  errorCode      String?         @map("error_code")
  indexedAt      DateTime        @default(now()) @map("indexed_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repo         ProjectRepo    @relation(fields: [organizationId, repoId], references: [organizationId, id], onDelete: Cascade)
  heads        SpecHead[]
  features     SpecFeature[]
  tables       SpecTable[]
  endpoints    SpecEndpoint[]

  @@unique([repoId, commitSha])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("spec_snapshots")
}

/// Pointeur de branche : l'interface lit la tête d'une branche, pas un SHA.
model SpecHead {
  organizationId String   @map("organization_id") @db.Uuid
  repoId         String   @map("repo_id") @db.Uuid
  branch         String
  snapshotId     String   @map("snapshot_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repo         ProjectRepo  @relation(fields: [organizationId, repoId], references: [organizationId, id], onDelete: Cascade)
  snapshot     SpecSnapshot @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)

  @@id([repoId, branch])
  @@index([organizationId])
  @@index([snapshotId])
  @@map("spec_heads")
}

/// CHECK de format sur `spec_id` (`^F-\d{3,}$`) dans la migration.
model SpecFeature {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  snapshotId     String          @map("snapshot_id") @db.Uuid
  specId         String          @map("spec_id")
  title          String
  status         FeatureStatus
  priority       FeaturePriority
  filePath       String          @map("file_path")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot      SpecSnapshot          @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)
  criteria      SpecCriterion[]
  tableLinks    SpecFeatureTable[]
  endpointLinks SpecFeatureEndpoint[]

  @@unique([snapshotId, specId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("spec_features")
}

/// CHECK de format sur `spec_id` (`^AC-\d+$`) dans la migration.
model SpecCriterion {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  featureId      String   @map("feature_id") @db.Uuid
  specId         String   @map("spec_id")
  position       Int
  title          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      SpecFeature  @relation(fields: [organizationId, featureId], references: [organizationId, id], onDelete: Cascade)

  @@unique([featureId, specId])
  @@unique([featureId, position])
  @@index([organizationId])
  @@map("spec_criteria")
}

/// CHECK de format sur `spec_id` (`^T-[a-z0-9][a-z0-9-]*$`) dans la migration.
model SpecTable {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  snapshotId     String   @map("snapshot_id") @db.Uuid
  specId         String   @map("spec_id")
  filePath       String   @map("file_path")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot     SpecSnapshot @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)

  @@unique([snapshotId, specId])
  @@index([organizationId])
  @@map("spec_tables")
}

/// CHECK de format sur `spec_id` (`^E-[a-z0-9][a-z0-9-]*$`) dans la migration.
model SpecEndpoint {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  snapshotId     String         @map("snapshot_id") @db.Uuid
  specId         String         @map("spec_id")
  method         EndpointMethod
  path           String
  filePath       String         @map("file_path")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot     SpecSnapshot @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)

  @@unique([snapshotId, specId])
  @@index([organizationId])
  @@map("spec_endpoints")
}

/// Pas de clé étrangère vers la table cible : une référence pendante est une erreur du validateur
/// (`@koklo/schema`, règle 4), pas un échec d'indexation. Liaison sans `created_at`/`updated_at`.
model SpecFeatureTable {
  organizationId String @map("organization_id") @db.Uuid
  featureId      String @map("feature_id") @db.Uuid
  targetSpecId   String @map("target_spec_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      SpecFeature  @relation(fields: [organizationId, featureId], references: [organizationId, id], onDelete: Cascade)

  @@id([featureId, targetSpecId])
  @@index([organizationId])
  @@map("spec_feature_tables")
}

/// Voir `SpecFeatureTable` : même forme, cible un endpoint.
model SpecFeatureEndpoint {
  organizationId String @map("organization_id") @db.Uuid
  featureId      String @map("feature_id") @db.Uuid
  targetSpecId   String @map("target_spec_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      SpecFeature  @relation(fields: [organizationId, featureId], references: [organizationId, id], onDelete: Cascade)

  @@id([featureId, targetSpecId])
  @@index([organizationId])
  @@map("spec_feature_endpoints")
}

/// Un lot = un commit du bot ; `id` = valeur du trailer `Koklo-Ops:`. `author_user_id` sans FK
/// (utilisateur supprimé). `report` : rapport de validation (objet JSON) ; `message` : message de
/// commit demandé ; `author_role` : rôle de l'auteur à la soumission. CHECK `committed` =>
/// `commit_sha` et `committed_at`, `failed|conflict` => `error_code`, `commit_sha` seulement si
/// `committed`, `report` objet ; index partiels : migration.
model SpecWriteBatch {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  repoId         String           @map("repo_id") @db.Uuid
  branch         String
  authorUserId   String?          @map("author_user_id") @db.Uuid
  idempotencyKey String           @map("idempotency_key")
  baseSha        String?          @map("base_sha")
  commitSha      String?          @map("commit_sha")
  status         WriteBatchStatus
  errorCode      String?          @map("error_code")
  report         Json?            @db.JsonB
  message        String?
  authorRole     String?          @map("author_role")
  enqueuedAt     DateTime         @default(now()) @map("enqueued_at") @db.Timestamptz(3)
  committedAt    DateTime?        @map("committed_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  repo         ProjectRepo          @relation(fields: [organizationId, repoId], references: [organizationId, id], onDelete: Cascade)
  operations   SpecWriteOperation[]

  @@unique([projectId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([repoId])
  @@map("spec_write_batches")
}

/// Une opération du lot (pas de colonne liste, incident 6). `kind` en texte : le vocabulaire
/// n'existe pas encore (contrat TK-42). `payload` est toujours un objet (CHECK).
model SpecWriteOperation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  position       Int
  kind           String
  targetSpecId   String?  @map("target_spec_id")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch        SpecWriteBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Cascade)

  @@unique([batchId, position])
  @@index([organizationId])
  @@map("spec_write_operations")
}

/// Journal de réception, HORS multi-tenant : une livraison arrive avant qu'on connaisse
/// l'organisation (l'événement `installation` précède même `provider_installations`). Aucune FK,
/// aucune colonne `organization_id`, ni signature ni en-têtes stockés. Dédoublonnage par
/// `UNIQUE(provider, delivery_id)` + `INSERT ... ON CONFLICT DO NOTHING`. Index partiel de
/// rattrapage `(status, received_at)` : migration.
model WebhookDelivery {
  id                     String                @id @default(uuid(7)) @db.Uuid
  provider               Provider
  deliveryId             String                @map("delivery_id")
  event                  WebhookEvent
  action                 String?
  installationExternalId String?               @map("installation_external_id")
  repoExternalId         String?               @map("repo_external_id")
  payload                Json
  status                 WebhookDeliveryStatus
  attempts               Int                   @default(0)
  errorCode              String?               @map("error_code")
  receivedAt             DateTime              @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt            DateTime?             @map("processed_at") @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, deliveryId])
  @@index([receivedAt])
  @@index([installationExternalId])
  @@map("webhook_deliveries")
}

/// État d'autorisation OAuth à usage unique (`consumed_at`), valable 10 minutes au plus (CHECK et index partiel : migration).
model ProviderAuthState {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  installationId String?   @map("installation_id") @db.Uuid
  nonce          String    @unique
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation ProviderInstallation? @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId])
  @@index([expiresAt])
  @@map("provider_auth_states")
}

/// Jeton utilisateur chiffré (AES-256-GCM) : `ciphertext` = chiffré suivi du tag de 16 octets, jamais en clair.
model ProviderUserCredential {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  installationId   String    @map("installation_id") @db.Uuid
  ciphertext       Bytes
  nonce            Bytes
  keyVersion       Int       @default(1) @map("key_version")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  refreshExpiresAt DateTime? @map("refresh_expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation ProviderInstallation @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([userId, installationId])
  @@index([organizationId])
  @@map("provider_user_credentials")
}
