generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// Tables Better Auth (+ plugin organization). Champs alignés sur la doc Better Auth.
model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions                Session[]
  accounts                Account[]
  members                 Member[]
  invitations             Invitation[]
  providerAuthStates      ProviderAuthState[]
  providerUserCredentials ProviderUserCredential[]

  @@map("users")
}

model Session {
  id                   String   @id @default(uuid(7)) @db.Uuid
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id") @db.Uuid
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members     Member[]
  invitations Invitation[]
  projects    Project[]

  tickets            Ticket[]
  ticketLabels       TicketLabel[]
  ticketFeatures     TicketFeature[]
  acceptanceCriteria AcceptanceCriterion[]
  ticketDependencies TicketDependency[]
  sprints            Sprint[]
  projectStates      ProjectState[]
  leases             Lease[]
  ticketComments     TicketComment[]
  auditLog           AuditLog[]
  projectCounters    ProjectCounter[]

  providerInstallations   ProviderInstallation[]
  projectRepos            ProjectRepo[]
  specSnapshots           SpecSnapshot[]
  specHeads               SpecHead[]
  specFeatures            SpecFeature[]
  specCriteria            SpecCriterion[]
  specTables              SpecTable[]
  specEndpoints           SpecEndpoint[]
  specFeatureTables       SpecFeatureTable[]
  specFeatureEndpoints    SpecFeatureEndpoint[]
  specWriteBatches        SpecWriteBatch[]
  specWriteOperations     SpecWriteOperation[]
  providerAuthStates      ProviderAuthState[]
  providerUserCredentials ProviderUserCredential[]
  llmProviderCredentials  LlmProviderCredential[]
  aiSettings              AiOrganizationSettings?
  aiUsageModels           AiUsageModel[]
  aiUsageMonthly          AiUsageMonthly[]

  @@map("organizations")
}

model Member {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications           Notification[]
  projectAccess           ProjectClientAccess[]
  projectVisits           ProjectVisit[]
  notificationPreferences NotificationPreference[]
  ideaContributions       IdeaPageContributor[]
  ideaPresences           IdeaPresence[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at")
  inviterId      String   @map("inviter_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User                @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  projects     InvitationProject[]

  // Cible de la clé composite d'invitation_projects (TK-97) : un lien ne peut pas viser une autre organisation.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([inviterId])
  @@map("invitations")
}

// Table métier : toute table métier porte organization_id indexé (CDC §18.4).
model Project {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets            Ticket[]
  sprints            Sprint[]
  state              ProjectState?
  counters           ProjectCounter[]
  repos              ProjectRepo[]
  writeBatches       SpecWriteBatch[]
  suggestions        Suggestion[]
  reviews            Review[]
  baselines          Baseline[]
  notifications      Notification[]
  clientAccess       ProjectClientAccess[]
  visits             ProjectVisit[]
  ideaPages          IdeaPage[]
  ideaPublications   IdeaPublication[]
  ideaPresences      IdeaPresence[]
  ideaMessages       IdeaMessage[]
  ideaProposals      IdeaProposal[]
  ideaAiLocks        IdeaAiLock[]
  ideaGapRuns        IdeaGapRun[]
  ideaVersions       IdeaVersion[]
  ideaSyntheses      IdeaSynthesis[]
  invitationProjects InvitationProject[]

  // Cible des clés étrangères composites (organization_id, project_id) des tables de TK-41 (H2).
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("projects")
}

// ---------------------------------------------------------------------------------------------
// Tickets, sprints, baux (CDC §4.2, §7). Listes fermées = enums natifs, alignés sur @koklo/domain
// (test de parité). Aucune colonne tableau (incident 6) : les listes sont des tables de liaison.
// Objets SQL non exprimables ici (index uniques partiels, CHECK, triggers) : voir la migration
// `*_tickets_sprints_leases/migration.sql`.
// ---------------------------------------------------------------------------------------------

enum TicketStatus {
  backlog
  todo
  in_progress
  in_review
  blocked
  done
  cancelled

  @@map("ticket_status")
}

enum TicketType {
  feature
  bug
  task
  chore

  @@map("ticket_type")
}

enum TicketPriority {
  low
  medium
  high
  critical

  @@map("ticket_priority")
}

enum TicketPackage {
  web
  api
  worker
  contract
  db
  domain
  schema
  github
  rules
  delivery
  cli
  ui
  config
  e2e
  infra

  @@map("ticket_package")
}

enum Sensitivity {
  safe
  sensitive

  @@map("sensitivity")
}

/// Titulaire d'un bail ou assigné d'un ticket (member ou runner).
enum HolderKind {
  member
  runner

  @@map("holder_kind")
}

enum DependencyType {
  blocks
  related

  @@map("dependency_type")
}

enum SprintStatus {
  planned
  active
  closed

  @@map("sprint_status")
}

enum ProofStatus {
  pending
  proven
  failed

  @@map("proof_status")
}

enum CommentTargetKind {
  ticket
  feature
  screen
  change_request

  @@map("comment_target_kind")
}

enum CommentAuthorKind {
  human
  agent
  client
  system

  @@map("comment_author_kind")
}

enum AuditActorKind {
  human
  agent
  runner
  system

  @@map("audit_actor_kind")
}

enum CounterName {
  ticket
  sprint
  feature
  suggestion

  @@map("counter_name")
}

model Ticket {
  id             String                   @id @default(uuid(7)) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  projectId      String                   @map("project_id") @db.Uuid
  key            String
  title          String
  description    String
  type           TicketType
  status         TicketStatus
  priority       TicketPriority
  sprintId       String?                  @map("sprint_id") @db.Uuid
  assigneeKind   HolderKind?              @map("assignee_kind")
  assigneeId     String?                  @map("assignee_id")
  pkg            TicketPackage
  sensitivity    Sensitivity
  estimateHours  Decimal?                 @map("estimate_hours") @db.Decimal(6, 2)
  branch         String?
  pullRequest    String?                  @map("pull_request")
  attempts       Int                      @default(0)
  reviewRounds   Int                      @default(0) @map("review_rounds")
  deletedAt      DateTime?                @map("deleted_at") @db.Timestamptz(3)
  /// Colonne générée (migration) : rang de la priorité, critical 0 à low 3 (ordre par défaut, B42). Jamais écrite par Prisma.
  priorityRank   Int?                     @default(dbgenerated("\nCASE priority\n    WHEN 'critical'::ticket_priority THEN 0\n    WHEN 'high'::ticket_priority THEN 1\n    WHEN 'medium'::ticket_priority THEN 2\n    ELSE 3\nEND")) @map("priority_rank")
  /// Colonne générée (migration) : numéro de la clé (TK-10 après TK-9), départage de l'ordre par défaut. Jamais écrite par Prisma.
  keyNumber      Int?                     @default(dbgenerated("COALESCE((\"substring\"(key, '-([0-9]{1,9})$'::text))::integer, 0)")) @map("key_number")
  /// Colonne générée (migration) : clé, titre et description, configuration `french`. Jamais écrite par Prisma.
  search         Unsupported("tsvector")? @default(dbgenerated("to_tsvector('french'::regconfig, ((((replace(key, '-'::text, ' '::text) || ' '::text) || title) || ' '::text) || description))"))
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?               @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  labels       TicketLabel[]
  features     TicketFeature[]
  criteria     AcceptanceCriterion[]
  dependencies TicketDependency[]    @relation("TicketDependsOn")
  dependents   TicketDependency[]    @relation("TicketDependedOnBy")
  leases       Lease[]

  @@unique([projectId, key])
  @@index([organizationId])
  @@index([projectId, status])
  @@index([sprintId])
  @@index([search], type: Gin)
  @@map("tickets")
}

model TicketLabel {
  organizationId String @map("organization_id") @db.Uuid
  ticketId       String @map("ticket_id") @db.Uuid
  label          String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([ticketId, label])
  @@index([organizationId])
  @@map("ticket_labels")
}

model TicketFeature {
  organizationId String @map("organization_id") @db.Uuid
  ticketId       String @map("ticket_id") @db.Uuid
  featureRef     String @map("feature_ref")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([ticketId, featureRef])
  @@index([organizationId])
  @@map("ticket_features")
}

model AcceptanceCriterion {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  ticketId       String      @map("ticket_id") @db.Uuid
  position       Int
  statement      String
  specRef        String?     @map("spec_ref")
  proofStatus    ProofStatus @default(pending) @map("proof_status")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, position])
  @@index([organizationId])
  @@map("acceptance_criteria")
}

/// `ticketId` dépend de `dependsOnId`. Pas de cycle ni d'auto-dépendance (CHECK) : le domaine refuse les cycles.
model TicketDependency {
  organizationId String         @map("organization_id") @db.Uuid
  ticketId       String         @map("ticket_id") @db.Uuid
  dependsOnId    String         @map("depends_on_id") @db.Uuid
  type           DependencyType

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation("TicketDependsOn", fields: [ticketId], references: [id], onDelete: Cascade)
  dependsOn    Ticket       @relation("TicketDependedOnBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([ticketId, dependsOnId, type])
  @@index([organizationId])
  @@index([dependsOnId])
  @@map("ticket_dependencies")
}

model Sprint {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  projectId        String       @map("project_id") @db.Uuid
  number           Int
  key              String
  goal             String
  startsOn         DateTime     @map("starts_on") @db.Date
  endsOn           DateTime     @map("ends_on") @db.Date
  status           SprintStatus
  definitionOfDone String       @map("definition_of_done")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@unique([projectId, number])
  @@index([organizationId])
  @@map("sprints")
}

/// Écriture optimiste : `UPDATE … WHERE project_id = $1 AND version = $attendue SET version = version + 1`.
model ProjectState {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @unique @map("project_id") @db.Uuid
  version        Int      @default(1)
  content        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("project_states")
}

/// Un seul bail non libéré par ticket (index unique partiel `WHERE released_at IS NULL`, migration).
model Lease {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  ticketId       String     @map("ticket_id") @db.Uuid
  holderKind     HolderKind @map("holder_kind")
  holderId       String     @map("holder_id")
  branch         String
  worktree       String
  acquiredAt     DateTime   @map("acquired_at") @db.Timestamptz(3)
  heartbeatAt    DateTime   @map("heartbeat_at") @db.Timestamptz(3)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  ttlMs          Int        @map("ttl_ms")
  releasedAt     DateTime?  @map("released_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ticketId])
  @@map("leases")
}

model TicketComment {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  targetKind     CommentTargetKind @map("target_kind")
  targetId       String            @map("target_id") @db.Uuid
  authorKind     CommentAuthorKind @map("author_kind")
  authorId       String?           @map("author_id")
  body           String
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([targetKind, targetId])
  @@map("ticket_comments")
}

/// Journal immuable (triggers UPDATE/DELETE/TRUNCATE, migration). Pas de `updated_at` : une ligne
/// n'est jamais modifiée (exception §18.1). Suppression permise uniquement avec l'organisation.
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  actorKind      AuditActorKind @map("actor_kind")
  actorId        String?        @map("actor_id")
  tokenId        String?        @map("token_id")
  action         String
  targetKind     String         @map("target_kind")
  targetId       String         @map("target_id") @db.Uuid
  ticketId       String?        @map("ticket_id") @db.Uuid
  /// Projet de l'écriture (TK-96) : posé par le serveur depuis la requête, jamais lu d'une ressource. NULL = écriture
  /// d'organisation (membre, clé, projet…). Sans clé étrangère ni cascade : le journal est append-only et survit au projet.
  projectId      String?        @map("project_id") @db.Uuid
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ticketId])
  @@index([organizationId, projectId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

/// Compteur transactionnel des clés lisibles (`TK-n`, `SP-n`) : ne recule jamais.
model ProjectCounter {
  organizationId String      @map("organization_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  name           CounterName
  lastValue      Int         @default(0) @map("last_value")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, name])
  @@index([organizationId])
  @@map("project_counters")
}

// ---------------------------------------------------------------------------------------------
// Fournisseur git, repos du projet, index de la spec, lots d'écriture du bot, webhooks (TK-41,
// CDC §4, §5, §8). Aucun secret en base : ni jeton d'installation, ni clé privée, ni user token.
// Les enfants référencent leur parent par une clé étrangère COMPOSITE (organization_id, parent_id)
// vers `UNIQUE(organization_id, id)` : une ligne ne peut pas pointer un parent d'une autre
// organisation, même en contournant l'extension tenant (H2). Objets SQL non exprimables ici (index
// partiels, CHECK) : voir la migration `*_provider_spec_index/migration.sql`.
// ---------------------------------------------------------------------------------------------

enum Provider {
  github

  @@map("provider")
}

enum InstallationStatus {
  active
  suspended
  deleted

  @@map("installation_status")
}

enum OwnerKind {
  organization
  user

  @@map("owner_kind")
}

enum RepoRole {
  spec
  front
  back
  monorepo
  mobile

  @@map("repo_role")
}

enum RepoMode {
  new
  adopted

  @@map("repo_mode")
}

enum WebhookEvent {
  installation
  push
  pull_request
  pull_request_review
  check_suite
  check_run
  workflow_run
  deployment_status

  @@map("webhook_event")
}

enum WebhookDeliveryStatus {
  received
  processing
  processed
  ignored
  failed

  @@map("webhook_delivery_status")
}

enum SpecIndexStatus {
  building
  ready
  failed

  @@map("spec_index_status")
}

enum FeatureStatus {
  brouillon
  specifiee
  implementee
  adoptee

  @@map("feature_status")
}

enum FeaturePriority {
  must
  should
  could
  wont

  @@map("feature_priority")
}

enum EndpointMethod {
  GET
  POST
  PUT
  PATCH
  DELETE

  @@map("endpoint_method")
}

enum WriteBatchStatus {
  queued
  committing
  committed
  failed
  conflict

  @@map("write_batch_status")
}

/// Identifiants publics côté fournisseur uniquement (CDC §20.3 : aucun jeton ni clé en base).
model ProviderInstallation {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  provider       Provider
  externalId     String             @map("external_id")
  ownerKind      OwnerKind          @map("owner_kind")
  ownerLogin     String             @map("owner_login")
  status         InstallationStatus
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repos           ProjectRepo[]
  authStates      ProviderAuthState[]
  userCredentials ProviderUserCredential[]

  @@unique([provider, externalId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("provider_installations")
}

/// Au plus un repo porteur de la spec par projet (index unique partiel, migration).
model ProjectRepo {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  installationId   String    @map("installation_id") @db.Uuid
  role             RepoRole
  mode             RepoMode
  externalId       String    @map("external_id")
  ownerLogin       String    @map("owner_login")
  name             String
  defaultBranch    String    @map("default_branch")
  specPath         String?   @map("spec_path")
  lastReconciledAt DateTime? @map("last_reconciled_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  installation ProviderInstallation @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Cascade)
  snapshots    SpecSnapshot[]
  heads        SpecHead[]
  writeBatches SpecWriteBatch[]

  @@unique([installationId, externalId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([projectId])
  @@map("project_repos")
}

/// Projection d'un commit de la spec (snapshot complet, reconstruction idempotente par commit).
model SpecSnapshot {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  repoId         String          @map("repo_id") @db.Uuid
  commitSha      String          @map("commit_sha")
  status         SpecIndexStatus
  errorCode      String?         @map("error_code")
  indexedAt      DateTime        @default(now()) @map("indexed_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repo         ProjectRepo    @relation(fields: [organizationId, repoId], references: [organizationId, id], onDelete: Cascade)
  heads        SpecHead[]
  features     SpecFeature[]
  tables       SpecTable[]
  endpoints    SpecEndpoint[]

  @@unique([repoId, commitSha])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("spec_snapshots")
}

/// Pointeur de branche : l'interface lit la tête d'une branche, pas un SHA.
model SpecHead {
  organizationId String   @map("organization_id") @db.Uuid
  repoId         String   @map("repo_id") @db.Uuid
  branch         String
  snapshotId     String   @map("snapshot_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repo         ProjectRepo  @relation(fields: [organizationId, repoId], references: [organizationId, id], onDelete: Cascade)
  snapshot     SpecSnapshot @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)

  @@id([repoId, branch])
  @@index([organizationId])
  @@index([snapshotId])
  @@map("spec_heads")
}

/// CHECK de format sur `spec_id` (`^F-\d{3,}$`) dans la migration.
model SpecFeature {
  id             String                   @id @default(uuid(7)) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  snapshotId     String                   @map("snapshot_id") @db.Uuid
  specId         String                   @map("spec_id")
  title          String
  status         FeatureStatus
  priority       FeaturePriority
  filePath       String                   @map("file_path")
  /// Colonne générée (migration) : numéro de `F-nnn`, tri numérique. Jamais écrite par Prisma.
  specNumber     Int?                     @default(dbgenerated("COALESCE((\"substring\"(spec_id, '^F-([0-9]{1,9})$'::text))::integer, 2147483647)")) @map("spec_number")
  /// Colonne générée (migration) : texte de recherche, configuration `french`.
  search         Unsupported("tsvector")? @default(dbgenerated("to_tsvector('french'::regconfig, ((replace(spec_id, '-'::text, ' '::text) || ' '::text) || title))"))
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot      SpecSnapshot          @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)
  criteria      SpecCriterion[]
  tableLinks    SpecFeatureTable[]
  endpointLinks SpecFeatureEndpoint[]

  @@unique([snapshotId, specId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([snapshotId, specNumber, id])
  @@index([search], type: Gin)
  @@map("spec_features")
}

/// CHECK de format sur `spec_id` (`^AC-\d+$`) dans la migration.
model SpecCriterion {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  featureId      String   @map("feature_id") @db.Uuid
  specId         String   @map("spec_id")
  position       Int
  title          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      SpecFeature  @relation(fields: [organizationId, featureId], references: [organizationId, id], onDelete: Cascade)

  @@unique([featureId, specId])
  @@unique([featureId, position])
  @@index([organizationId])
  @@map("spec_criteria")
}

/// CHECK de format sur `spec_id` (`^T-[a-z0-9][a-z0-9-]*$`) dans la migration.
model SpecTable {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  snapshotId     String   @map("snapshot_id") @db.Uuid
  specId         String   @map("spec_id")
  filePath       String   @map("file_path")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot     SpecSnapshot @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)

  @@unique([snapshotId, specId])
  @@index([organizationId])
  @@map("spec_tables")
}

/// CHECK de format sur `spec_id` (`^E-[a-z0-9][a-z0-9-]*$`) dans la migration.
model SpecEndpoint {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  snapshotId     String         @map("snapshot_id") @db.Uuid
  specId         String         @map("spec_id")
  method         EndpointMethod
  path           String
  filePath       String         @map("file_path")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot     SpecSnapshot @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)

  @@unique([snapshotId, specId])
  @@index([organizationId])
  @@map("spec_endpoints")
}

/// Pas de clé étrangère vers la table cible : une référence pendante est une erreur du validateur
/// (`@koklo/schema`, règle 4), pas un échec d'indexation. Liaison sans `created_at`/`updated_at`.
model SpecFeatureTable {
  organizationId String @map("organization_id") @db.Uuid
  featureId      String @map("feature_id") @db.Uuid
  targetSpecId   String @map("target_spec_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      SpecFeature  @relation(fields: [organizationId, featureId], references: [organizationId, id], onDelete: Cascade)

  @@id([featureId, targetSpecId])
  @@index([organizationId])
  @@map("spec_feature_tables")
}

/// Voir `SpecFeatureTable` : même forme, cible un endpoint.
model SpecFeatureEndpoint {
  organizationId String @map("organization_id") @db.Uuid
  featureId      String @map("feature_id") @db.Uuid
  targetSpecId   String @map("target_spec_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      SpecFeature  @relation(fields: [organizationId, featureId], references: [organizationId, id], onDelete: Cascade)

  @@id([featureId, targetSpecId])
  @@index([organizationId])
  @@map("spec_feature_endpoints")
}

/// Un lot = un commit du bot ; `id` = valeur du trailer `Koklo-Ops:`. `author_user_id` sans FK
/// (utilisateur supprimé). `report` : rapport de validation (objet JSON) ; `message` : message de
/// commit demandé ; `author_role` : rôle de l'auteur à la soumission. CHECK `committed` =>
/// `commit_sha` et `committed_at`, `failed|conflict` => `error_code`, `commit_sha` seulement si
/// `committed`, `report` objet ; index partiels : migration.
model SpecWriteBatch {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  repoId         String           @map("repo_id") @db.Uuid
  branch         String
  authorUserId   String?          @map("author_user_id") @db.Uuid
  idempotencyKey String           @map("idempotency_key")
  baseSha        String?          @map("base_sha")
  commitSha      String?          @map("commit_sha")
  status         WriteBatchStatus
  errorCode      String?          @map("error_code")
  report         Json?            @db.JsonB
  message        String?
  authorRole     String?          @map("author_role")
  enqueuedAt     DateTime         @default(now()) @map("enqueued_at") @db.Timestamptz(3)
  committedAt    DateTime?        @map("committed_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  repo         ProjectRepo          @relation(fields: [organizationId, repoId], references: [organizationId, id], onDelete: Cascade)
  operations   SpecWriteOperation[]

  @@unique([projectId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([repoId])
  @@map("spec_write_batches")
}

/// Une opération du lot (pas de colonne liste, incident 6). `kind` en texte : le vocabulaire
/// n'existe pas encore (contrat TK-42). `payload` est toujours un objet (CHECK).
model SpecWriteOperation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  position       Int
  kind           String
  targetSpecId   String?  @map("target_spec_id")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch        SpecWriteBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Cascade)

  @@unique([batchId, position])
  @@index([organizationId])
  @@map("spec_write_operations")
}

/// Journal de réception, HORS multi-tenant : une livraison arrive avant qu'on connaisse
/// l'organisation (l'événement `installation` précède même `provider_installations`). Aucune FK,
/// aucune colonne `organization_id`, ni signature ni en-têtes stockés. Dédoublonnage par
/// `UNIQUE(provider, delivery_id)` + `INSERT ... ON CONFLICT DO NOTHING`. Index partiel de
/// rattrapage `(status, received_at)` : migration.
model WebhookDelivery {
  id                     String                @id @default(uuid(7)) @db.Uuid
  provider               Provider
  deliveryId             String                @map("delivery_id")
  event                  WebhookEvent
  action                 String?
  installationExternalId String?               @map("installation_external_id")
  repoExternalId         String?               @map("repo_external_id")
  payload                Json
  status                 WebhookDeliveryStatus
  attempts               Int                   @default(0)
  errorCode              String?               @map("error_code")
  receivedAt             DateTime              @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt            DateTime?             @map("processed_at") @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, deliveryId])
  @@index([receivedAt])
  @@index([installationExternalId])
  @@map("webhook_deliveries")
}

/// État d'autorisation OAuth à usage unique (`consumed_at`), valable 10 minutes au plus (CHECK et index partiel : migration).
model ProviderAuthState {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  installationId String?   @map("installation_id") @db.Uuid
  nonce          String    @unique
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation ProviderInstallation? @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId])
  @@index([expiresAt])
  @@map("provider_auth_states")
}

/// Jeton utilisateur chiffré (AES-256-GCM) : `ciphertext` = chiffré suivi du tag de 16 octets, jamais en clair.
model ProviderUserCredential {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  installationId   String    @map("installation_id") @db.Uuid
  ciphertext       Bytes
  nonce            Bytes
  keyVersion       Int       @default(1) @map("key_version")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  refreshExpiresAt DateTime? @map("refresh_expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation ProviderInstallation @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([userId, installationId])
  @@index([organizationId])
  @@map("provider_user_credentials")
}

/// Fournisseurs LLM stockables (BYOK) ; `fake` n'existe qu'en test, jamais en base.
enum LlmProvider {
  anthropic
  openai
  google
  mistral
  openrouter
  openai_compatible

  @@map("llm_provider")
}

/// Identifiant BYOK chiffré (AES-256-GCM), un par organisation et fournisseur. `ciphertext` = chiffré suivi du
/// tag de 16 octets, jamais en clair. L'AAD n'est pas stockée : `llm:v1:<organization_id>:<provider>`.
/// `createdByUserId` sans clé étrangère : l'utilisateur peut disparaître sans effacer la clé.
model LlmProviderCredential {
  id              String      @id @default(uuid(7)) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  provider        LlmProvider
  ciphertext      Bytes
  nonce           Bytes
  keyVersion      Int         @default(1) @map("key_version")
  defaultModel    String?     @map("default_model")
  /// Adresse de base : présente si et seulement si `provider = openai_compatible` (CHECK hors Prisma, https seul).
  baseUrl         String?     @map("base_url")
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  lastUsedAt      DateTime?   @map("last_used_at") @db.Timestamptz(3)
  invalidatedAt   DateTime?   @map("invalidated_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryOf    AiOrganizationSettings[] @relation("AiPrimaryCredential")
  fallbackOf   AiOrganizationSettings[] @relation("AiFallbackCredential")
  usageModels  AiUsageModel[]

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("llm_provider_credentials")
}

/// Usages d'IA du produit (TK-95) : un modèle est choisi par usage.
enum AiUsage {
  idea_space
  spec_deliverables
  baseline_summary
  ticket_breakdown

  @@map("ai_usage")
}

/// Réglages d'IA d'une organisation (TK-95). Le principal et le secours sont des clés enregistrées de
/// l'organisation (clé étrangère composite, NO ACTION) et diffèrent (CHECK). `monthlyCapMicroUsd` : plafond
/// mensuel unique en micro-dollars, nul = pas de plafond (A1) ; `capWarnedMonth` : premier jour du mois
/// pour lequel l'alerte de 80 % a déjà été émise.
model AiOrganizationSettings {
  organizationId     String       @id @map("organization_id") @db.Uuid
  primaryProvider    LlmProvider? @map("primary_provider")
  fallbackProvider   LlmProvider? @map("fallback_provider")
  fallbackEnabled    Boolean      @default(true) @map("fallback_enabled")
  monthlyCapMicroUsd BigInt?      @map("monthly_cap_micro_usd")
  capWarnedMonth     DateTime?    @map("cap_warned_month") @db.Date
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primary      LlmProviderCredential? @relation("AiPrimaryCredential", fields: [organizationId, primaryProvider], references: [organizationId, provider], onDelete: NoAction)
  fallback     LlmProviderCredential? @relation("AiFallbackCredential", fields: [organizationId, fallbackProvider], references: [organizationId, provider], onDelete: NoAction)

  @@map("ai_organization_settings")
}

/// Modèle choisi pour un usage (TK-95) : le fournisseur doit avoir une clé (cascade au retrait de la clé).
model AiUsageModel {
  organizationId String      @map("organization_id") @db.Uuid
  usage          AiUsage
  provider       LlmProvider
  model          String
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential   LlmProviderCredential @relation(fields: [organizationId, provider], references: [organizationId, provider], onDelete: Cascade)

  @@id([organizationId, usage])
  @@map("ai_usage_models")
}

/// Consommation d'IA par organisation, mois UTC (premier jour) et fournisseur (TK-95). Compteurs en
/// BIGINT bornés par CHECK (>= 0), incrémentés atomiquement. Aucune clé vers les clés : l'historique
/// survit au retrait d'une clé. Coût en micro-dollars (B18).
model AiUsageMonthly {
  organizationId String      @map("organization_id") @db.Uuid
  month          DateTime    @db.Date
  provider       LlmProvider
  calls          Int         @default(0)
  inputTokens    BigInt      @default(0) @map("input_tokens")
  outputTokens   BigInt      @default(0) @map("output_tokens")
  costMicroUsd   BigInt      @default(0) @map("cost_micro_usd")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, month, provider])
  @@map("ai_usage_monthly")
}

/// Statut d'une suggestion client (TK-51b).
enum SuggestionStatus {
  open
  accepted
  rejected
  withdrawn

  @@map("suggestion_status")
}

/// Objet visé par une suggestion : une fonctionnalité (`F-nnn`), un écran, ou le projet entier (sans `target_ref`).
enum SuggestionTargetKind {
  feature
  screen
  project

  @@map("suggestion_target_kind")
}

/// Suggestion d'un client sur un projet, numérotée `SG-n` par projet (compteur `suggestion`). `body` et
/// `decisionNote` sont du texte non fiable, stocké brut : il n'entre dans un prompt que via `Untrusted("client-suggestion")`.
/// `authorUserId` et `decidedByUserId` sans clé étrangère (RGPD : l'utilisateur peut disparaître). Une seule clé étrangère,
/// composite vers `projects` (la cascade de l'organisation passe par le projet). CHECK : voir la migration.
model Suggestion {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  projectId       String               @map("project_id") @db.Uuid
  key             String
  targetKind      SuggestionTargetKind @map("target_kind")
  targetRef       String?              @map("target_ref")
  body            String
  authorUserId    String?              @map("author_user_id") @db.Uuid
  authorRole      String?              @map("author_role")
  baseSha         String?              @map("base_sha")
  status          SuggestionStatus     @default(open)
  decidedByUserId String?              @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?            @map("decided_at") @db.Timestamptz(3)
  decisionNote    String?              @map("decision_note")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, key])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([projectId, status, createdAt])
  @@map("suggestions")
}

/// Cible d'une review client (TK-51c).
enum ReviewTargetKind {
  feature
  screen
  baseline

  @@map("review_target_kind")
}

/// Verdict d'une review client (TK-51c).
enum ReviewStatus {
  approved
  changes_requested

  @@map("review_status")
}

/// Cycle d'une baseline (TK-51c) : proposed -> validated -> tagged.
enum BaselineStatus {
  proposed
  validated
  tagged

  @@map("baseline_status")
}

/// Journal append-only des reviews client (TK-51c) : la dernière review d'une cible fait foi, aucune unicité cible/SHA/auteur.
/// Immuable (trigger `reviews_immutable`, voir la migration) sauf suppression en cascade du projet. `repoId` sans clé étrangère : le journal survit au dépôt délié.
/// `authorUserId` sans clé étrangère (RGPD). Humain uniquement : les invariants (cible, SHA, repo du projet) sont vérifiés côté API.
model Review {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  repoId         String           @map("repo_id") @db.Uuid
  targetKind     ReviewTargetKind @map("target_kind")
  targetRef      String           @map("target_ref")
  sha            String
  status         ReviewStatus
  authorUserId   String           @map("author_user_id") @db.Uuid
  authorRole     String?          @map("author_role")
  comment        String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project    @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  baselines Baseline[]

  @@unique([organizationId, id])
  @@unique([organizationId, projectId, id])
  @@index([organizationId])
  @@index([projectId, targetKind, targetRef, createdAt(sort: Desc)])
  @@map("reviews")
}

/// Baselines d'un projet (TK-51c) : la baseline 0 est le point de départ ; au plus une baseline non taguée par projet
/// (index unique partiel, migration). Validation et tag : humain uniquement.
model Baseline {
  id               String         @id @default(uuid(7)) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  projectId        String         @map("project_id") @db.Uuid
  repoId           String         @map("repo_id") @db.Uuid
  number           Int
  status           BaselineStatus @default(proposed)
  proposedSha      String         @map("proposed_sha")
  proposedByUserId String?        @map("proposed_by_user_id") @db.Uuid
  reviewId         String?        @map("review_id") @db.Uuid
  validatedAt      DateTime?      @map("validated_at") @db.Timestamptz(3)
  tagSha           String?        @map("tag_sha")
  taggedAt         DateTime?      @map("tagged_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  review  Review? @relation(fields: [organizationId, projectId, reviewId], references: [organizationId, projectId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, number])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, projectId, reviewId])
  @@map("baselines")
}

/// Notifications in-app (TK-51d) : une ligne par destinataire et par événement, sans charge utile (l'API relit l'objet
/// via `subjectKind`/`subjectRef` avec les droits du destinataire). `type` et `subjectKind` : texte contraint par CHECK
/// (liste fermée, migration). Idempotence : unique (recipientUserId, dedupeKey). Index partiel des non lues : migration.
model Notification {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  type            String
  projectId       String?   @map("project_id") @db.Uuid
  subjectKind     String    @map("subject_kind")
  subjectRef      String    @map("subject_ref")
  dedupeKey       String    @map("dedupe_key")
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)
  emailState      String    @default("pending") @map("email_state")
  emailedAt       DateTime? @map("emailed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipient Member   @relation(fields: [organizationId, recipientUserId], references: [organizationId, userId], onDelete: Cascade, onUpdate: NoAction)
  project   Project? @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recipientUserId, dedupeKey])
  @@index([organizationId])
  @@map("notifications")
}

/// Liaison client <-> projet (TK-55a) : un membre `client` ne voit que les projets liés (cloisonnement central de l'API).
/// Que le membre ait le rôle `client` est un invariant d'API, pas de la base. `createdByUserId` : trace sans FK.
model ProjectClientAccess {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  member  Member  @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, userId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, userId])
  @@map("project_client_access")
}

/// Dernier projet ouvert par un membre (TK-88, B80) : une ligne par membre et projet, rafraîchie à chaque ouverture.
/// Préférence personnelle, sans effet sur les droits : l'accès au projet est toujours revérifié à la lecture.
model ProjectVisit {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  visitedAt      DateTime @default(now()) @map("visited_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  member  Member  @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, userId])
  @@index([organizationId, userId, visitedAt(sort: Desc)])
  @@map("project_visits")
}

/// Projets proposés à une invitation client ou business (TK-97, B98). À l'acceptation, un hook Better Auth en fait des
/// liens `project_client_access` ; la ligne ne donne aucun accès par elle-même.
model InvitationProject {
  id             String   @id @default(uuid(7)) @db.Uuid
  invitationId   String   @map("invitation_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invitation Invitation @relation(fields: [organizationId, invitationId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  project    Project    @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([invitationId, projectId])
  @@index([organizationId])
  @@map("invitation_projects")
}

/// Préférence d'e-mail d'un membre (TK-97, B101) : absence de ligne = valeur par défaut du contrat. `key` est contrainte par un
/// CHECK (liste fermée `NOTIFICATION_PREFERENCE_KEYS`, hors Prisma). Une préférence désactivée passe la notification en `skipped`.
model NotificationPreference {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  enabled        Boolean
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Member @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, organizationId, key])
  @@index([organizationId])
  @@map("notification_preferences")
}

/// Origine d'une page de l'espace Idée (TK-89) : gabarit serveur, ajout humain, ajout d'agent (TK-90).
enum IdeaPageOrigin {
  template
  user
  agent

  @@map("idea_page_origin")
}

/// Statut d'une page de l'espace Idée (TK-89) : vide -> brouillon -> à relire -> stable.
enum IdeaPageStatus {
  empty
  draft
  review
  stable

  @@map("idea_page_status")
}

/// Page du dossier d'idée d'un projet (TK-89). `slug` ne change jamais (unique à vie, corbeille comprise) ;
/// `position` 0..n-1 sur les pages actives ; `version` s'incrémente à chaque enregistrement du contenu
/// (compare-and-set). `updatedBy` sans clé étrangère (RGPD). CHECK : voir la migration.
model IdeaPage {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  slug           String
  title          String
  position       Int
  required       Boolean        @default(false)
  origin         IdeaPageOrigin
  templateKey    String?        @map("template_key")
  status         IdeaPageStatus @default(empty)
  contentMd      String         @default("") @map("content_md")
  version        Int            @default(1)
  updatedBy      String?        @map("updated_by") @db.Uuid
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project               @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  contributors IdeaPageContributor[]

  @@unique([projectId, slug])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([projectId, deletedAt, position])
  @@map("idea_pages")
}

/// Publication de l'espace Idée (TK-89) : écrite quand le lot de publication est `committed`.
/// `pagesVersions` : versions de contenu publiées par slug. `publishedBy` sans clé étrangère (RGPD).
model IdeaPublication {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  batchId        String?  @map("batch_id") @db.Uuid
  commitSha      String   @map("commit_sha")
  publishedBy    String?  @map("published_by") @db.Uuid
  publishedAt    DateTime @map("published_at") @db.Timestamptz(3)
  pagesVersions  Json     @map("pages_versions") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, batchId])
  @@index([organizationId])
  @@index([projectId, publishedAt(sort: Desc)])
  @@map("idea_publications")
}

/// Contributeur d'une page (TK-89) : alimenté à l'enregistrement, au renommage et à la création ; la publication
/// en tire les `Co-authored-by`. Une ligne par (page, membre).
model IdeaPageContributor {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  lastAddedAt    DateTime @map("last_added_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  page   IdeaPage @relation(fields: [organizationId, pageId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  member Member   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pageId, userId])
  @@index([organizationId])
  @@map("idea_page_contributors")
}

/// Présence sur l'espace Idée (TK-89) : une ligne par (projet, membre), en base (multi-instances) ; active si
/// vue depuis moins de 45 s. `pageId` : la page ouverte, sans clé étrangère (la page peut partir en corbeille).
model IdeaPresence {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  pageId         String?  @map("page_id") @db.Uuid
  seenAt         DateTime @map("seen_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  member  Member  @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, userId])
  @@index([organizationId])
  @@index([projectId, seenAt])
  @@map("idea_presence")
}

/// Opération d'une proposition de l'agent sur l'espace Idée (TK-90). Le Markdown n'a pas d'identifiant de bloc : une
/// proposition vise le rang d'un bloc de premier niveau à `baseVersion`.
enum IdeaProposalOp {
  insert_after
  replace
  append
  create_page

  @@map("idea_proposal_op")
}

/// Cycle d'une proposition : en attente -> acceptée ou rejetée (annulable 10 s) ; périmée dès que la page change.
enum IdeaProposalStatus {
  pending
  accepted
  rejected
  stale

  @@map("idea_proposal_status")
}

/// Mode de l'agent à l'envoi d'un message : entretien guidé ou échange libre.
enum IdeaMessageMode {
  interview
  free

  @@map("idea_message_mode")
}

/// Auteur d'un message du fil : un humain (`authorUserId`) ou l'agent (sans auteur).
enum IdeaMessageAuthor {
  human
  agent

  @@map("idea_message_author")
}

/// Message du fil de l'agent d'un projet (TK-90). `pageId` : la page de contexte, sans clé étrangère (la page peut partir
/// en corbeille). `authorUserId` sans clé étrangère (RGPD). CHECK : voir la migration.
model IdeaMessage {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  pageId         String?           @map("page_id") @db.Uuid
  authorUserId   String?           @map("author_user_id") @db.Uuid
  author         IdeaMessageAuthor
  mode           IdeaMessageMode
  text           String
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project        @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  proposals IdeaProposal[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([projectId, createdAt])
  @@map("idea_messages")
}

/// Proposition de l'agent (TK-90) : jamais appliquée sans `idea.proposal.decide` par un humain. `baseVersion` : version
/// de la page à la proposition (absente pour `create_page`). `previousContentMd` et `resultVersion` servent l'annulation.
/// `decidedBy` sans clé étrangère (RGPD). CHECK : voir la migration.
model IdeaProposal {
  id                String             @id @default(uuid(7)) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  projectId         String             @map("project_id") @db.Uuid
  pageId            String?            @map("page_id") @db.Uuid
  messageId         String             @map("message_id") @db.Uuid
  op                IdeaProposalOp
  anchorBlockIndex  Int?               @map("anchor_block_index")
  rangeEnd          Int?               @map("range_end")
  title             String?
  afterPageId       String?            @map("after_page_id") @db.Uuid
  contentMd         String             @map("content_md")
  rationale         String
  baseVersion       Int?               @map("base_version")
  status            IdeaProposalStatus @default(pending)
  decidedBy         String?            @map("decided_by") @db.Uuid
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(3)
  previousContentMd String?            @map("previous_content_md")
  resultVersion     Int?               @map("result_version")
  createdPageId     String?            @map("created_page_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project     @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  message IdeaMessage @relation(fields: [organizationId, messageId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@map("idea_proposals")
}

/// Verrou d'un appel d'IA (TK-90) : un seul à la fois par (projet, utilisateur), pris en base (plusieurs instances) et
/// repris à `expiresAt` (120 s). `userId` sans clé étrangère.
model IdeaAiLock {
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([projectId, userId])
  @@index([organizationId])
  @@map("idea_ai_locks")
}

/// Dernier calcul de « Ce qui manque encore » d'un projet (TK-90) : un résultat de moins de 30 s est rendu sans appel du
/// modèle. `items` : tableau JSON (CHECK).
model IdeaGapRun {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @unique @map("project_id") @db.Uuid
  computedAt     DateTime @map("computed_at") @db.Timestamptz(3)
  items          Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
  @@map("idea_gap_runs")
}

/// Version figée de l'idée (TK-91) : `idea-vN`, numérotée sans trou par projet (CHECK 1..9999, étiquette `idea-v<N>`).
/// `batchId` : le lot de publication qui la porte ; `commitSha` : renseigné quand ce lot est commité ; une version dont le
/// lot échoue est supprimée. `pagesVersions` : version de contenu figée par slug. `frozenBy` sans clé étrangère (RGPD).
model IdeaVersion {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  number         Int
  tag            String
  batchId        String?  @map("batch_id") @db.Uuid
  commitSha      String?  @map("commit_sha")
  pagesVersions  Json     @map("pages_versions") @db.JsonB
  frozenBy       String?  @map("frozen_by") @db.Uuid
  frozenAt       DateTime @map("frozen_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, number])
  @@unique([projectId, batchId])
  @@index([organizationId])
  @@map("idea_versions")
}

/// Synthèse de l'idée d'un projet (TK-91) : une ligne par projet. `source` = `idea-vN` quand elle a été publiée avec
/// cette version, vide pour un aperçu (jamais publié). Texte généré : jamais d'identité.
model IdeaSynthesis {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @unique @map("project_id") @db.Uuid
  contentMd      String   @map("content_md")
  source         String?
  generatedAt    DateTime @map("generated_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
  @@map("idea_synthesis")
}
