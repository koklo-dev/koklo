{
  "name": "@koklo/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./theme.css": "./src/styles/theme.css",
    "./tentative.css": "./src/styles/tentative.css",
    "./status.css": "./src/styles/status.css",
    "./typography.css": "./src/styles/typography.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "lint": "biome ci --config-path=../.. .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@koklo/config": "workspace:*",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
