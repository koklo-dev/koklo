{
  "name": "@koklo/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./theme.css": "./src/styles/theme.css",
    "./tentative.css": "./src/styles/tentative.css",
    "./status.css": "./src/styles/status.css",
    "./typography.css": "./src/styles/typography.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "lint": "biome ci --config-path=../.. .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "e2e": "playwright test",
    "icons:generate": "node scripts/generate-icons.ts"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@koklo/config": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react-resizable-panels": "4.15.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@material-symbols/svg-400": "0.48.2",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
