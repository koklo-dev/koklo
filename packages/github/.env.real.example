# Variables des tests REELS de @koklo/github (procedure : packages/github/README.md).
#
#   cp .env.real.example .env.real     # .env.real est ignore par git : ne JAMAIS le commiter
#   set -a; . ./.env.real; set +a
#   pnpm --filter @koklo/github test:real
#
# Prefixe KOKLO_GH_ : GitHub refuse les secrets dont le nom commence par GITHUB_.
# Aucune valeur reelle ici. Les 10 variables sont obligatoires (le script refuse de demarrer
# s'il en manque une : un test "saute" ne vaut jamais "vert").

# --- GitHub App de TEST (jamais l'App de production) ---

# Identifiant numerique de l'App (page des parametres de l'App, "App ID").
KOKLO_GH_APP_ID=

# Cle privee de l'App au format PEM (multi-ligne entre guillemets, ou "\n" echappes).
# Alternative : laisser vide et renseigner KOKLO_GH_PRIVATE_KEY_PATH=/chemin/vers/cle.pem
# (l'une OU l'autre est exigee).
KOKLO_GH_PRIVATE_KEY=

# Client ID de l'App (commence par "Iv1." ou "Iv23").
KOKLO_GH_CLIENT_ID=

# Client secret de l'App (sert a valider et rafraichir les jetons utilisateur).
KOKLO_GH_CLIENT_SECRET=

# --- Organisation de test (les depots bac a sable y sont crees) ---

# Login de l'organisation de test.
KOKLO_GH_ORG_LOGIN=

# Identifiant numerique de l'installation de l'App sur l'organisation
# (URL de la page d'installation : .../settings/installations/<id>).
KOKLO_GH_ORG_INSTALLATION_ID=

# --- Compte personnel de test ---

# Login du compte personnel de test.
KOKLO_GH_USER_LOGIN=

# Identifiant numerique de l'installation de l'App sur ce compte personnel.
KOKLO_GH_USER_INSTALLATION_ID=

# Jeton d'acces UTILISATEUR de l'App (flux "user authorization", jetons expirants), valide
# pour KOKLO_GH_USER_LOGIN. Dure 8 h : en regenerer un avant chaque execution.
KOKLO_GH_USER_TOKEN=

# Date d'expiration de ce jeton, ISO 8601 UTC (ex. 2026-01-01T12:00:00Z).
KOKLO_GH_USER_TOKEN_EXPIRES_AT=

# --- Optionnel ---

# Chemin d'un fichier PEM, a la place de KOKLO_GH_PRIVATE_KEY.
# KOKLO_GH_PRIVATE_KEY_PATH=

# Prefixe des depots bac a sable (defaut : koklo-sandbox).
# KOKLO_GH_SANDBOX_PREFIX=koklo-sandbox
