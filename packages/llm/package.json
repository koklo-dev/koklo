{
  "name": "@koklo/llm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "lint": "biome ci --config-path=../.. .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:real": "node scripts/run-real.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/google": "4.0.114",
    "@ai-sdk/mistral": "4.0.81",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/openai-compatible": "3.0.87",
    "@koklo/domain": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.166"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@koklo/config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
