{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "extends": ["./packages/config/biome.json"],
  "files": {
    "includes": [
      "**",
      "!**/fixtures",
      "!**/coverage",
      "!**/test-results",
      "!**/dist",
      "!**/generated",
      "!**/.next",
      "!pnpm-lock.yaml"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "lucide",
                  "lucide-*",
                  "lucide/*"
                ],
                "message": "Ic\u00f4nes : utiliser le composant Icon de @koklo/ui (Material Symbols Rounded)."
              }
            ]
          }
        }
      }
    }
  }
}
