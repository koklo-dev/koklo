{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "extends": ["./packages/config/biome.json"],
  "files": {
    "includes": [
      "**",
      "!**/fixtures",
      "!**/coverage",
      "!**/test-results",
      "!**/dist",
      "!**/generated",
      "!**/.next",
      "!pnpm-lock.yaml"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["lucide", "lucide-*", "lucide/*"],
                "message": "Icônes : utiliser le composant Icon de @koklo/ui (Material Symbols Rounded)."
              },
              {
                "group": [
                  "@koklo/domain/testing",
                  "@koklo/domain/testing/*",
                  "@koklo/llm/testing",
                  "@koklo/llm/testing/*"
                ],
                "message": "Les faux (FakeLlm, transport simulé) sont réservés aux tests et au lanceur e2e : jamais dans le code livré (TK-54, ADR 0015)."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/src/testing/**", "**/*.test.ts", "e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["lucide", "lucide-*", "lucide/*"],
                    "message": "Icônes : utiliser le composant Icon de @koklo/ui (Material Symbols Rounded)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
