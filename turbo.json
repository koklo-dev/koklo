{
  "$schema": "https://turbo.build/schema.json",
  "boundaries": {
    "tags": {
      "domain": { "dependencies": { "allow": ["contract", "config"] } },
      "db": { "dependencies": { "allow": ["domain", "config"] } },
      "contract": { "dependencies": { "allow": ["config"] } },
      "schema": { "dependencies": { "allow": ["config"] } },
      "github": { "dependencies": { "allow": ["domain", "contract", "config"] } },
      "rules": { "dependencies": { "allow": ["domain", "contract", "config"] } },
      "delivery": { "dependencies": { "allow": ["domain", "contract", "rules", "config"] } },
      "cli": {
        "dependencies": { "allow": ["contract", "schema", "delivery", "rules", "config"] }
      },
      "api": { "dependencies": { "deny": ["cli", "ui", "web"] } },
      "worker": { "dependencies": { "deny": ["cli", "ui", "web"] } },
      "web": { "dependencies": { "allow": ["contract", "ui", "schema", "config"] } },
      "ui": { "dependencies": { "allow": ["config"] } }
    }
  },
  "globalPassThroughEnv": [
    "KOKLO_DB_PORT",
    "KOKLO_API_PORT",
    "E2E_DB_PORT",
    "E2E_WEB_PORT",
    "E2E_API_PORT",
    "E2E_WEB_URL"
  ],
  "tasks": {
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT",
        "API_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "APP_ENV",
        "APP_VERSION"
      ]
    },
    "e2e": { "cache": false }
  }
}
