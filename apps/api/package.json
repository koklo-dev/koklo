{
  "name": "@koklo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && pnpm start",
    "import:sprints": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/cli/import-sprints.main.js"
  },
  "dependencies": {
    "@koklo/config": "workspace:*",
    "@koklo/contract": "workspace:*",
    "@koklo/db": "workspace:*",
    "@koklo/domain": "workspace:*",
    "@koklo/github": "workspace:*",
    "@koklo/observability": "workspace:*",
    "@koklo/schema": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@orpc/nest": "2.0.0-beta.46",
    "@orpc/server": "2.0.0-beta.46",
    "better-auth": "1.7.14",
    "express": "5.3.0",
    "nestjs-pino": "5.3.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@koklo/worker": "workspace:*",
    "@nestjs/testing": "12.2.0",
    "@sentry/node": "11.10.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
