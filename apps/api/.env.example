# Copier en .env (ignoré par git). Port de la base aligné sur KOKLO_DB_PORT du docker-compose racine.
DATABASE_URL=postgresql://koklo:koklo@127.0.0.1:5432/koklo
PORT=3000
APP_ENV=development
# Injectée par l'infra à chaque déploiement ; "dev" par défaut en local.
APP_VERSION=dev
# Better Auth : secret d'au moins 32 caractères (génération : openssl rand -base64 32). Jamais commité.
BETTER_AUTH_SECRET=
# URL publique de l'API ; callback GitHub : <BETTER_AUTH_URL>/api/auth/callback/github
BETTER_AUTH_URL=http://localhost:3000
# OAuth App GitHub (une par environnement). Le secret est saisi dans l'environnement, jamais ici.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
