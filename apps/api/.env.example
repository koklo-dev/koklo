# Copier en .env (ignoré par git). Port de la base aligné sur KOKLO_DB_PORT du docker-compose racine.
DATABASE_URL=postgresql://koklo:koklo@127.0.0.1:5432/koklo
PORT=3000
APP_ENV=development
# Injectée par l'infra à chaque déploiement ; "dev" par défaut en local.
APP_VERSION=dev
# Better Auth : secret d'au moins 32 caractères (génération : openssl rand -base64 32). Jamais commité.
BETTER_AUTH_SECRET=
# URL publique du web (l'API n'est pas exposée : le navigateur passe par le proxy du web) ;
# callback GitHub : <BETTER_AUTH_URL>/api/auth/callback/github
BETTER_AUTH_URL=http://localhost:3000
# OAuth App GitHub (une par environnement). Le secret est saisi dans l'environnement, jamais ici.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Niveau des journaux JSON (stdout) : fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# DSN GlitchTip/Sentry (URL). Vide : aucune remontée d'erreurs. Fourni par l'infra en déploiement.
SENTRY_DSN=
# GitHub App de l'épique (fournisseur de dépôts : dépôt de spec). GITHUB_APP_ID et GITHUB_APP_PRIVATE_KEY
# vont ensemble (tout ou rien) : sans les deux, l'API démarre sans fournisseur et répond
# 503 PROVIDER_UNAVAILABLE à repo.createSpec et repo.link. Clé PEM sur une ligne : base64 (format de
# l'infra) ou PEM avec des \n littéraux.
# GITHUB_APP_CLIENT_ID et GITHUB_APP_CLIENT_SECRET sont facultatifs (jetons utilisateur, flux absent),
# fournis ensemble ou pas du tout. Ce ne sont PAS GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET (OAuth de
# connexion, autre application GitHub) : ne jamais les confondre.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
