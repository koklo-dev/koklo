# Copier en .env (ignoré par git). Port de la base aligné sur KOKLO_DB_PORT du docker-compose racine.
DATABASE_URL=postgresql://koklo:koklo@127.0.0.1:5432/koklo
PORT=3000
APP_ENV=development
# Injectée par l'infra à chaque déploiement ; "dev" par défaut en local.
APP_VERSION=dev
# Better Auth : secret d'au moins 32 caractères (génération : openssl rand -base64 32). Jamais commité.
BETTER_AUTH_SECRET=
# URL publique du web (l'API n'est pas exposée : le navigateur passe par le proxy du web) ;
# callback GitHub : <BETTER_AUTH_URL>/api/auth/callback/github
BETTER_AUTH_URL=http://localhost:3000
# OAuth App GitHub (une par environnement). Le secret est saisi dans l'environnement, jamais ici.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Niveau des journaux JSON (stdout) : fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# DSN GlitchTip/Sentry (URL). Vide : aucune remontée d'erreurs. Fourni par l'infra en déploiement.
SENTRY_DSN=
# GitHub App de l'épique (fournisseur de dépôts : dépôt de spec). GITHUB_APP_ID et GITHUB_APP_PRIVATE_KEY
# vont ensemble (tout ou rien) : sans les deux, l'API démarre sans fournisseur et répond
# 503 PROVIDER_UNAVAILABLE à repo.createSpec et repo.link. Clé PEM sur une ligne : base64 (format de
# l'infra) ou PEM avec des \n littéraux.
# GITHUB_APP_CLIENT_ID et GITHUB_APP_CLIENT_SECRET sont facultatifs (jetons utilisateur, flux absent),
# fournis ensemble ou pas du tout. Ce ne sont PAS GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET (OAuth de
# connexion, autre application GitHub) : ne jamais les confondre.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Clé AES-256 des jetons utilisateur GitHub conservés chiffrés en base : 32 octets en base64
# (génération : openssl rand -base64 32). L'infra la génère à chaque environnement (manifeste,
# `generate` : 32 lettres et chiffres, accepté tel quel). Exigée dès que GITHUB_APP_CLIENT_ID et
# GITHUB_APP_CLIENT_SECRET sont fournis ; perdue ou changée, les jetons stockés deviennent illisibles.
KOKLO_ENCRYPTION_KEY=
# Rotation (facultatif) : version de KOKLO_ENCRYPTION_KEY (entier >= 1, défaut 1) et anciennes clés
# `version:clé` séparées par des virgules, toutes inférieures à la version courante, pour relire les
# données chiffrées avant la rotation. Vides : pas de rotation.
KOKLO_ENCRYPTION_KEY_VERSION=
KOKLO_ENCRYPTION_KEYS_PREVIOUS=
# Secret de signature des webhooks GitHub (valeur saisie dans la GitHub App, champ « Webhook secret »).
# Absent ou vide : l'API démarre (un avertissement est journalisé) et POST /api/webhooks/github répond 503.
GITHUB_WEBHOOK_SECRET=
# Attente maximale (ms, entier de 1 à 60000) de specBatch.submit avant de rendre le lot en cours
# (queued ou committing) ; le client interroge ensuite specBatch.get. Défaut : 8000.
SPEC_BATCH_WAIT_MS=
# Plafonds des appels au modèle (propositions ai.*, vérification de clé), entiers de 1 à 100000 ; vides :
# valeurs par défaut du code. Quotas calculés sur le journal d'audit (fenêtre glissante d'une heure).
# Appels ai.* par heure et par organisation. Défaut : 30.
AI_MAX_CALLS_PER_HOUR_ORG=
# Appels ai.* par heure et par utilisateur. Défaut : 10.
AI_MAX_CALLS_PER_HOUR_USER=
# Vérifications de clé (llmCredential.verify) par heure et par organisation. Défaut : 5.
AI_MAX_VERIFY_PER_HOUR_ORG=
# Appels simultanés par organisation et par processus. Défaut : 2.
AI_MAX_CONCURRENT_PER_ORG=
