# Copier en .env (ignoré par git). Base partagée avec l'api (port aligné sur KOKLO_DB_PORT).
DATABASE_URL=postgresql://koklo:koklo@127.0.0.1:5432/koklo
APP_ENV=development
# Posée par l'image de production ; avec NODE_ENV=production, APP_ENV est obligatoire et la capture des e-mails est refusée.
NODE_ENV=development
# Injectée par l'infra à chaque déploiement ; "dev" par défaut en local.
APP_VERSION=dev
# Niveau des journaux JSON (stdout) : fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# DSN GlitchTip/Sentry (URL). Vide : aucune remontée d'erreurs.
SENTRY_DSN=
# Envoi d'emails. Vides en development/test : les messages sont capturés en mémoire, rien ne part.
# Obligatoires en staging/production (injectées par l'infra, jamais committées).
RESEND_API_KEY=
MAIL_DOMAIN=
EMAIL_FROM=
# Origine publique du web, base des liens des e-mails de notification : origine seule (sans identifiants,
# chemin, requête ni fragment). Obligatoire et https en staging/production ; défaut local ci-dessous.
WEB_BASE_URL=http://localhost:3000
# GitHub App (lots d'écriture de la spec, job spec-write). GITHUB_APP_ID et GITHUB_APP_PRIVATE_KEY vont
# ensemble (tout ou rien) : sans les deux, le worker démarre sans fournisseur et chaque lot échoue en
# PROVIDER_UNAVAILABLE. Clé PEM sur une ligne : base64 (format de l'infra) ou PEM avec des \n littéraux.
# GITHUB_APP_CLIENT_ID et GITHUB_APP_CLIENT_SECRET sont facultatifs, fournis ensemble ou pas du tout.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Rétention des livraisons de webhook (journal de réception), en jours : entier de 1 à 365, défaut 30.
# Une tâche planifiée (03:17 UTC) supprime les livraisons plus anciennes. Une valeur invalide empêche le démarrage.
WEBHOOK_RETENTION_DAYS=30
# Réconciliation périodique (job planifié toutes les 10 min, UTC) : une livraison de webhook ou un lot
# d'écriture non réglé depuis plus de N minutes, sans job vivant, est ré-enfilé. Entier de 5 à 1440, défaut 15.
# Une valeur invalide empêche le démarrage.
RECONCILE_GRACE_MINUTES=15
# Budget d'appels au fournisseur git de la passe « têtes de spec » de la réconciliation, par run (toutes les 10 min) :
# authentification comprise ; le reste attend le run suivant. Entier de 10 à 5000, défaut 300. Une valeur invalide empêche le démarrage.
RECONCILE_MAX_PROVIDER_CALLS=300
