{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koklo",
  "version": "0.1.0",
  "identifier": "dev.koklo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Koklo",
        "width": 1200,
        "height": 800,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Koklo",
        "width": 480,
        "height": 320,
        "center": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
